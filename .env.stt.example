# Explicitly select with scripts/stt.py --env-file /absolute/profile ACTION.
COMPOSE_PROJECT_NAME=example-authsom-prod
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.5@sha256:37dbaf6f0722c9ec246335f36e1ef8b2e6cb960f7c27e0d8c615121a3d475a85
POSTGRES_IMAGE=postgres:17.11-alpine3.24@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
KEYCLOAK_HOSTNAME=https://auth.example.com
KEYCLOAK_HTTP_PORT=18081
KEYCLOAK_REALM=educacion
KEYCLOAK_REALM_DISPLAY_NAME=SSO Example
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
CONFIG_ROOT=/srv/example/configuraciones/authsom/prod
SECRET_ROOT=/srv/example/secretos/authsom/prod
DATA_ROOT=/srv/example/datos/authsom/prod
BACKUP_ROOT=/srv/example/respaldos/authsom/prod
BACKUP_KEEP=7
# Separate private secrets.env: KEYCLOAK_DB_PASSWORD; bootstrap credentials only initially.
