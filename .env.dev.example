# Entorno de desarrollo local (sin TLS). Copiar a .env y cambiar los valores.
# Arranque: docker compose -f compose.yaml -f compose.dev.yaml up -d --wait --wait-timeout 300
# Proyecto y volumen propios (authsom-dev); no toca la instalación de producción.
KEYCLOAK_ADMIN_USERNAME=sso-admin
KEYCLOAK_ADMIN_PASSWORD=cambiame-admin-dev

# URL pública del SSO de desarrollo, sin TLS y sin barra final.
KEYCLOAK_HOSTNAME=http://localhost:8081

# Base de datos interna del proyecto dev.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=cambiame-db-dev

# Integración con el Moodle de desarrollo (por defecto 127.0.0.1:18080).
MOODLE_BASE_URL=http://localhost:18080
MOODLE_OIDC_CLIENT_SECRET=cambiame-moodle-dev

# Publicación del puerto HTTP; 0.0.0.0 permite que otros servicios del host lo alcancen.
KEYCLOAK_BIND_ADDRESS=0.0.0.0
KEYCLOAK_HTTP_PORT=8081

# Usuario de prueba del realm educacion (ver DEV.md).
DEV_TEST_USER=devuser
DEV_TEST_PASSWORD=cambiame-test-dev
