# Copiar a .env y sustituir los valores de ejemplo antes del primer arranque.
KEYCLOAK_ADMIN_USERNAME=sso-admin
KEYCLOAK_ADMIN_PASSWORD=reemplazar-con-una-clave-admin-unica

# URL pública HTTPS del SSO, sin barra final.
KEYCLOAK_HOSTNAME=https://auth.example.com

# Base de datos interna.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=reemplazar-con-una-clave-db-unica

# Integración inicial con Moodle, sin barra final.
MOODLE_BASE_URL=https://moodle.example.com
MOODLE_OIDC_CLIENT_SECRET=reemplazar-con-un-secreto-moodle-unico

# Opciones de despliegue. El acceso HTTP queda local por defecto.
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_PROXY_HEADERS=xforwarded
